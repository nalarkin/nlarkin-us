{
  "name": "nlarkin-us",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@4.18.1",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint pages components lib",
    "deploy": "yarn clean && NEXT_STATIC_EXPORT=1 next build --webpack",
    "clean": "node -e \"for (const path of ['.next', 'out']) require('node:fs').rmSync(path, { recursive: true, force: true })\"",
    "build-types": "tsc --noEmit --pretty",
    "postinstall": "husky install",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "test": "jest --watch",
    "cypress:open:mobile": "cypress open --config viewportWidth=375,viewportHeight=667",
    "cypress:run:mobile": "cypress run --config viewportWidth=375,viewportHeight=667"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource/roboto": "^4.5.1",
    "@mui/icons-material": "^5.18.0",
    "@mui/material": "^5.18.0",
    "@portabletext/react": "^6.0.0",
    "@sanity/client": "^8.10.0",
    "@sanity/image-url": "^2.1.1",
    "classnames": "^2.3.1",
    "clsx": "^1.1.1",
    "date-fns": "^2.24.0",
    "fuse.js": "^6.4.6",
    "gray-matter": "^4.0.3",
    "groq": "^2.15.0",
    "next": "16.4.2",
    "next-seo": "^4.28.1",
    "plaiceholder": "^2.2.0",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-preset-env": "^11.6.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-gtm-module": "^2.0.11",
    "react-icons": "^5.5.0",
    "remark": "^14.0.2",
    "remark-html": "^15.0.1",
    "remark-parse": "^10.0.1",
    "sass": "^1.42.1",
    "sharp": "^0.35.5",
    "swiper": "8.4.7",
    "unified": "^10.1.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^7.1.0",
    "@jest/globals": "^30.5.2",
    "@next/eslint-plugin-next": "16.4.2",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-gtm-module": "^2.0.1",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "autoprefixer": "^10.3.4",
    "cypress": "^16.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^7.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "lint-staged": "^11.2.0",
    "msw": "^0.41.1",
    "postcss": "^8.5.31",
    "prettier": "^2.4.1",
    "sanity-codegen": "^0.9.5",
    "tailwindcss": "^2.2.15",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.tsx": "eslint --cache --fix",
    "*.ts": "eslint --cache --fix"
  },
  "engines": {
    "node": "24.x"
  },
  "resolutions": {
    "@types/react": "^19.0.0"
  }
}
